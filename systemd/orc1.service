[Unit]
Description=ORC-1 Chord Engine
After=sound.target

[Service]
User=pibox
ExecStartPre=/bin/bash -c 'for i in $(seq 1 30); do [ -e /dev/snd/seq ] && aconnect -l >/dev/null 2>&1 && exit 0; sleep 0.5; done; exit 0'
ExecStart=/usr/bin/python3 -u /home/pibox/orc/orc1/orc1.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
