[Unit]
Description=ORC-1: rtpMIDI "FLAME rtp" <-> the Fire's DAW port (the Fire's DAW mode over the network)
After=rtpmidid.service
Wants=rtpmidid.service

[Service]
Type=simple
User=pibox
WorkingDirectory=/home/pibox/orc/orc1
ExecStart=/usr/bin/python3 /home/pibox/orc/orc1/orc1_flame_rtp.py
Restart=on-failure
RestartSec=5
# Tiny helper: it must never compete with the audio side (skipback comes first)
Nice=10
CPUSchedulingPolicy=idle
MemoryMax=64M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
